# ===========================================
# AI Travel Agent - Environment Variables
# ===========================================
# Kopieren Sie diese Datei zu .env.local und füllen Sie die Werte aus

# ===========================================
# DATENBANK KONFIGURATION
# ===========================================

# PostgreSQL Verbindungs-URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_travel_agent"

# ===========================================
# OLLAMA KONFIGURATION
# ===========================================

# Ollama Server URL (Standard: localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# Standard-Modell für KI-Antworten
OLLAMA_MODEL="mistral:7b"

# ===========================================
# NEXTAUTH KONFIGURATION (Authentifizierung)
# ===========================================

# NextAuth URL (Development)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret (generieren Sie ein sicheres Secret)
# Befehl: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key"

# ===========================================
# EXTERNE API KEYS (Optional)
# ===========================================

# OpenAI API Key (als Fallback, falls Ollama nicht verfügbar)
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic Claude API Key (Alternative zu OpenAI)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# ===========================================
# ENTWICKLUNG & DEBUGGING
# ===========================================

# Node Environment
NODE_ENV="development"

# Debug-Modus aktivieren
DEBUG="*"

# Ollama Debug-Modus
OLLAMA_DEBUG="false"

# ===========================================
# PERFORMANCE & OPTIMIERUNG
# ===========================================

# Ollama Host (für GPU-Beschleunigung)
OLLAMA_HOST="0.0.0.0"

# Ollama Origins (CORS)
OLLAMA_ORIGINS="*"

# ===========================================
# SICHERHEIT
# ===========================================

# CORS Origins (für Production)
# NEXTAUTH_URL="https://your-domain.com"
# CORS_ORIGINS="https://your-domain.com,https://www.your-domain.com"

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Log Level
LOG_LEVEL="info"

# Sentry DSN (für Error Tracking)
SENTRY_DSN=""

# ===========================================
# PRODUCTION KONFIGURATION
# ===========================================

# Für Production Deployment
# NODE_ENV="production"
# DATABASE_URL="postgresql://prod-user:prod-password@prod-host:5432/prod-database"
# NEXTAUTH_URL="https://your-production-domain.com"
# NEXTAUTH_SECRET="your-production-secret"

# ===========================================
# HILFE & TIPPS
# ===========================================

# 1. Erstellen Sie .env.local basierend auf dieser Datei
# 2. Füllen Sie nur die benötigten Variablen aus
# 3. Niemals .env.local committen (ist in .gitignore)
# 4. Für Production: Verwenden Sie sichere Secrets
# 5. Testen Sie die Verbindungen vor dem Start

# ===========================================
# BEISPIEL KONFIGURATION
# ===========================================

# Minimal-Konfiguration für lokale Entwicklung:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_travel_agent"
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="mistral:7b"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="your-secret-key" 